; Four pinned jobs write disjoint regions through four virtqueues.
[global]
filename=/dev/disk/by-id/virtio-cas-experiment
ioengine=io_uring
direct=1
rw=write
bs=4k
size=16m
iodepth=32
fsync=32
verify=crc32c
do_verify=1
verify_fatal=1
refill_buffers=1
end_fsync=1

[queue-smoke-0]
offset=0m
cpus_allowed=0

[queue-smoke-1]
offset=16m
cpus_allowed=1

[queue-smoke-2]
offset=32m
cpus_allowed=2

[queue-smoke-3]
offset=48m
cpus_allowed=3
