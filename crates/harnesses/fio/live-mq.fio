; One guest retains four queues across a backend crash; regions do not overlap.
[global]
filename=/dev/disk/by-id/virtio-cas-experiment
ioengine=io_uring
direct=1
bs=4k
size=1m
iodepth=32
rw=write
verify=crc32c
verify_fatal=1
refill_buffers=1
end_fsync=1

[live-recovery-0]
offset=0m
cpus_allowed=0

[live-recovery-1]
offset=1m
cpus_allowed=1

[live-recovery-2]
offset=2m
cpus_allowed=2

[live-recovery-3]
offset=3m
cpus_allowed=3
